    "node": ">=20.19.0 <23.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "husky": "^8.0.0",
    "prettier": "3.0.1",
